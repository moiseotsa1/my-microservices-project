FROM node:18-alpine

WORKDIR /app

# Copier les fichiers du projet
COPY package*.json ./
RUN npm install

COPY . .

# Corriger les URLs dans les fichiers source
RUN sed -i 's|http://localhost:3001|http://api-gateway/user-service|g' src/App.jsx && \
    sed -i 's|http://localhost:3002|http://api-gateway/product-service|g' src/App.jsx && \
    sed -i 's|http://localhost:3003|http://api-gateway/order-service|g' src/App.jsx && \
    sed -i 's|http://localhost:\${port}/health|http://api-gateway/health|g' src/App.jsx

# Corriger le .env.production
RUN echo "VITE_USER_SERVICE_URL=http://api-gateway/user-service" > .env.production && \
    echo "VITE_PRODUCT_SERVICE_URL=http://api-gateway/product-service" >> .env.production && \
    echo "VITE_ORDER_SERVICE_URL=http://api-gateway/order-service" >> .env.production && \
    echo "VITE_PAYMENT_SERVICE_URL=http://api-gateway/payment-service" >> .env.production && \
    echo "VITE_NOTIFICATION_SERVICE_URL=http://api-gateway/notification-service" >> .env.production

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host"]
